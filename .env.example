# FlashMart - required environment variables per service.
# Copy to a repo-root .env (gitignored) to keep the values in one place. Spring
# does NOT read .env: export the values into the shell that starts each
# service, or set them in the IDE Run Configuration > Environment variables.
# application.yml references them as ${DB_USERNAME} etc. (docker compose does
# read the repo-root .env, for its own ${...} values.) See docs/development.md.

# --- All four services (local Postgres) ---
# One shared credential pair, deliberately: every service points at the same
# local Postgres instance, and this is a portfolio project, not a production
# deployment. Each service still owns a separate DATABASE on that instance -
# identity-service, inventory-service, order-service, notification-service -
# so the "services never share a schema" rule holds. Split these into
# per-service variables only if the services ever get separate credentials.
DB_USERNAME=
DB_PASSWORD=

# --- Ports (set in each application.yml, not here; listed for reference) ---
# 8080  api-gateway
# 8081  identity-service
# 8082  inventory-service
# 8083  order-service
# 8084  notification-service
# 8085  payment-stub (127.0.0.1 only)
# 8761  eureka-server (start after config-server; see docs/development.md)
# 8888  config-server (start first)

# --- Local infra via docker-compose.yml (optional; the defaults are shown) ---
# Host ports the containers publish. Only the kafka service is used today;
# Postgres is a local install on 5432, so do not start compose's postgres (it
# would clash). DB_USERNAME / DB_PASSWORD above are also what that Postgres
# container would be created with. The services' application.yml files point
# at localhost:5432, so change POSTGRES_PORT only if you also change those URLs.
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092

# --- Payment webhook (Order verifies, payment stub signs; same value in both) ---
# HMAC-SHA256 secret over the raw webhook body. Local dev value only.
PAYMENT_WEBHOOK_SECRET=change-me-local-dev-only

# --- Day 8 secrets ---
# No defaults. A service that needs one refuses to start if it is blank, like
# PAYMENT_WEBHOOK_SECRET. Use two DIFFERENT random values of your own. Never
# commit a real value.
# JWT signing/verifying key (HS256). Held by identity-service and the gateway only.
# identity-service reads it now and refuses to start if it is blank or shorter
# than 32 bytes (e.g. 32 random bytes, base64: openssl rand -base64 32). The
# api-gateway reads it too (same rule) and must use the SAME value as identity.
JWT_SECRET=
# HMAC key for the signed buyer-id header (X-Buyer-Id / X-Auth-Timestamp /
# X-Auth-Signature). Held by the api-gateway and order-service only; SAME value
# in both, DIFFERENT from JWT_SECRET. Both refuse to start if it is blank or
# shorter than 32 bytes.
GATEWAY_SIGNING_SECRET=

# --- Config server (Day 9) ---
# No secret needed: the config repo is public and read without credentials.
# CONFIG_REPO_URI points config-server at another repo (default shown); a
# file:// URI of a local clone also works. CONFIG_BASEDIR is where it clones.
# CONFIG_REPO_URI=https://github.com/akshxnsh/flashmart-config
# CONFIG_BASEDIR=
# Any moved value can still be forced with an env var, which beats the config
# server, e.g. IDENTITY_JWT_ACCESSTTL=20m (see decisions.md, Day 9, Part 0).

# --- Monitoring (Day 9, Part B; docker compose up -d prometheus grafana) ---
# Grafana admin password. No default: compose refuses to start without it, like
# DB_PASSWORD. Pick your own; never commit a real value. Prometheus needs none.
GRAFANA_ADMIN_PASSWORD=
# Host ports (defaults shown).
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# --- Optional overrides (the values shown are the defaults, so setting them
# changes nothing; set them only to point elsewhere) ---
# Order's Kafka bootstrap for the outbox relay (the compose broker's HOST listener).
KAFKA_BOOTSTRAP=localhost:9092
# Where the payment stub delivers webhooks (Order's endpoint).
ORDER_WEBHOOK_URL=http://localhost:8083/webhooks/payment

# --- Optional, read by the helper scripts only (the values shown are the defaults;
# bash scripts/seed/seed.sh, load-tests/reset-run.sh and the other load-tests/*.sh) ---
# DB_HOST=localhost
# DB_PORT=5432
# IDENTITY_URL=http://localhost:8081
# BUYERS=5000
# WARMUP=200
# CONCURRENCY=            # parallel signups/logins; default = CPU count
# HTTP_TIMEOUT_S=30
# FLASH_SALE_ID=1         # check-orders.sh / verify.sh
# PRODUCT_ID=1
# ITEM_ID=1
