# FlashMart - required environment variables per service.
# No .env file is actually loaded at runtime - these are set per-service via
# the IDE Run Configuration > Environment variables, and are referenced from
# application.yml as ${DB_USERNAME} / ${DB_PASSWORD}. This file exists purely
# so anyone cloning the repo knows what needs to be set, and where.

# --- Inventory Service (inventory-service / local Postgres) ---
DB_USERNAME=
DB_PASSWORD=
