# FlashMart - required environment variables per service.
# No .env file is actually loaded at runtime - these are set per-service via
# the IDE Run Configuration > Environment variables, and are referenced from
# application.yml as ${DB_USERNAME} / ${DB_PASSWORD}. This file exists purely
# so anyone cloning the repo knows what needs to be set, and where.

# --- All four services (local Postgres) ---
# One shared credential pair, deliberately: every service points at the same
# local Postgres instance, and this is a portfolio project, not a production
# deployment. Each service still owns a separate DATABASE on that instance -
# identity-service, inventory-service, order-service, notification-service -
# so the "services never share a schema" rule holds. Split these into
# per-service variables only if the services ever get separate credentials.
DB_USERNAME=
DB_PASSWORD=

# --- Ports (set in each application.yml, not here; listed for reference) ---
# 8080  API Gateway (reserved, not built yet)
# 8081  identity-service
# 8082  inventory-service
# 8083  order-service
# 8084  notification-service
