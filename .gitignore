# Local secrets - never commit real values. Real files stay untracked;
# only .env.example (checked in) documents the shape.
.env
.env.*.local

# OS cruft
.DS_Store
Thumbs.db

# IDE config is machine-local and not shared. The root .idea/ was previously
# tracked, which meant a broken module definition followed every clone; each
# service's own .gitignore already ignored .idea, so this settles the two
# conventions in favour of ignoring it.
.idea/
*.iml
*.iws
*.ipr

# Per-service build/IDE ignores live in each service's own .gitignore
# (generated by Spring Initializr) - not duplicated here.

# Gatling build output and HTML reports
load-tests/target/

# Access tokens written by load-tests/make-tokens.sh: live credentials until they expire
load-tests/tokens/
